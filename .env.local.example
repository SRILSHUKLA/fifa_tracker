# Supabase — Project Settings > Data API > "Project URL".
# Must be the bare origin with NO path. Do not paste the "RESTful endpoint"
# (.../rest/v1) shown further down that page: supabase-js appends /auth/v1 and
# /rest/v1 itself, and a doubled path fails with "Invalid path specified in
# request URL".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API Keys — the "Publishable key" (sb_publishable_...) or,
# on older projects, the "anon public" JWT. Never the service_role/secret key:
# that one bypasses Row Level Security and must not reach the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
